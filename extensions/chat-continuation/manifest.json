{
  "manifest_version": 3,
  "name": "WebCodex Continuation",
  "description": "Continue, Goal and Loop for ChatGPT with the existing WebCodex backend.",
  "version": "0.5.2",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["activity.js"], "run_at": "document_start", "all_frames": false}],
  "action": {"default_popup": "popup.html", "default_title": "WebCodex Continuation"}
}
